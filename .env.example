# Copy to .env. Embedded PostgreSQL is for local development only.
NODE_ENV=development
PORT=5000
USE_EMBEDDED_DB=true
EMBEDDED_DB_PATH=.local/postgres
# To use native PostgreSQL, set USE_EMBEDDED_DB=false and provide DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clothing_store
DATABASE_SSL=false
SESSION_SECRET=change-this-to-a-random-secret-at-least-32-characters
ADMIN_EMAIL=admin@clothing.local
ADMIN_PASSWORD=ChangeMe!2026
AUTO_MIGRATE=true
SEED_CATALOG=true
# Only local development can seed example orders. Never enable for a real shop.
SEED_DEMO_ORDERS=true
# Required in production; set to the exact deployed origin.
APP_ORIGIN=http://localhost:5173
